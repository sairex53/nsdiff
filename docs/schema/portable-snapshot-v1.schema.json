        "entries": {
          "type": "array",
          "minItems": 33,
          "maxItems": 33,
          "items": {
            "$ref": "#/$defs/environment_entry_info"
          }
        }
      }
    },
    "network_set_info": {
      "type": "object",
      "required": [
        "status",
        "count",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "permission-denied",
            "not-supported",
            "process-gone",
            "io-error",
            "parse-error",
            "truncated"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "description": "Non-NUL bytes, maximum decoded length 191 bytes. UTF-8 byte length is checked by the importer.",
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "encoding",
                  "value"
                ],
                "properties": {
                  "encoding": {
                    "const": "utf-8"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 191,
                    "pattern": "^[^\\u0000]*$"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "encoding",
                  "value"
                ],
                "properties": {
                  "encoding": {
                    "const": "hex"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 382,
                    "pattern": "^(?:(?!00)[0-9a-f]{2})*$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "network_info": {
      "type": "object",
      "required": [
        "interfaces",
        "ipv4_default_routes",
        "ipv6_addresses",
        "ipv6_default_routes"
      ],
      "properties": {
        "interfaces": {
          "$ref": "#/$defs/network_set_info"
        },
        "ipv4_default_routes": {
          "$ref": "#/$defs/network_set_info"
        },
        "ipv6_addresses": {
          "$ref": "#/$defs/network_set_info"
        },
        "ipv6_default_routes": {
          "$ref": "#/$defs/network_set_info"
        }
      }
    },
    "process_snapshot": {
      "type": "object",
      "required": [
        "pid",
        "starttime_ticks",
        "namespaces",
        "proc_status",
        "limits",
        "cgroup",
        "mounts",
        "environment",
        "network"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "starttime_ticks": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 20,
          "description": "Unsigned decimal, <=18446744073709551615; importer also checks destination type range."
        },
        "namespaces": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/namespace_info"
          }
        },
        "proc_status": {
          "$ref": "#/$defs/proc_status_info"
        },
        "limits": {
          "$ref": "#/$defs/limits_info"
        },
        "cgroup": {
          "$ref": "#/$defs/cgroup_info"
        },
        "mounts": {
          "$ref": "#/$defs/mounts_info"
        },
        "environment": {
          "$ref": "#/$defs/environment_info"
        },
        "network": {
          "$ref": "#/$defs/network_info"
        }
      }
    }
  }
}
