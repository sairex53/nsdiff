nsdiff_sources = files(
  'process.c',
  'proc_read.c',
  'snapshot_io.c',
  'snapshot_native.c',
  'snapshot_portable.c',
  'snapshot_model.c',
  'snapshot_atomic.c',
  'sha256.c',
  'json_bytes.c',
  'json_writer.c',
  'render_snapshot.c',
  'namespaces.c',
  'proc_status.c',
  'limits.c',
  'cgroup.c',
  'mounts.c',
  'environment.c',
  'network.c',
  'diff.c',
  'diff_summary.c',
  'scope.c',
  'render.c',
  'render_network.c',
  'render_json.c',
  'render_network_json.c',
  'render_compact.c',
  'render_summary.c',
)

nsdiff_core = static_library('nsdiff-core', nsdiff_sources,
  include_directories: [inc, config_inc],
  dependencies: [jansson_dep, libcap_dep, libmount_dep], install: false)
nsdiff_exe = executable('nsdiff', 'main.c',
  include_directories: [inc, config_inc],
  dependencies: [jansson_dep, libcap_dep, libmount_dep],
  link_with: nsdiff_core, install: true)
